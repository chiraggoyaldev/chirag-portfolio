# Copy to `.env.local` for local development. Never commit real keys —
# `.env*.local` is gitignored. In production set these in
# Vercel → Project → Settings → Environment Variables.

# Required for the contact form. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Where contact-form messages are delivered.
# Defaults to the address in src/lib/content.ts.
#
# IMPORTANT: while using Resend's shared test sender (below), delivery is only
# permitted to the address that owns the Resend account. Register the Resend
# account with this address, or sends will be rejected.
CONTACT_TO_EMAIL=

# Optional. Defaults to onboarding@resend.dev, Resend's shared test sender.
# Once you verify your own domain in Resend, change this to something like
# hello@yourdomain.com for better deliverability and no recipient restriction.
CONTACT_FROM_EMAIL=
